# Copy to .env and fill in. Never commit .env.

# Required for the server: a random lock for the REST API (24+ chars)
#   python3 -c "import secrets;print(secrets.token_urlsafe(32))"
SCOUT_API_KEY=

# Legacy shared MCP URL (disabled by default; do not enable for multi-user hosting).
SCOUT_MCP_SECRET=
SCOUT_ALLOW_SHARED_MCP=0

# Per-user Instagram Business Login (use the Instagram App ID + Instagram App Secret
# from the Instagram product's API setup, not the generic Meta App ID).
SCOUT_PUBLIC_URL=https://scout.solodac.com
SCOUT_IG_CLIENT_ID=
SCOUT_IG_CLIENT_SECRET=
SCOUT_IG_REDIRECT_URI=https://scout.solodac.com/auth/instagram/callback
SCOUT_IG_GRAPH_VERSION=v27.0
# Generate once and keep stable across restarts; encrypts each user's Meta token at rest.
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SCOUT_TOKEN_ENCRYPTION_KEY=
# Optional separate auth database path; default is SCOUT_DB + ".auth".
# SCOUT_AUTH_DB=/data/.scout/auth.sqlite

# YouTube Data API key(s). Extra keys spread the daily quota.
YOUTUBE_API_KEY=
# YOUTUBE_API_KEY_2=

# Instagram (your own Meta app). One account:
SCOUT_IG_TOKEN=
SCOUT_IG_USER_ID=
# ...or several tokens in a JSON file: SCOUT_IG_POOL=/data/.scout/ig_pool.json

# Creator breakdowns: who to compare with, and the handle on the end card
SCOUT_SHOWCASE_ME=
SCOUT_SHOWCASE_CTA=

# Reel transcription is off by default. Turning it on downloads reels with yt-dlp, which Instagram's terms do not allow
# and usually needs a logged-in cookies file. Your call and your responsibility.
SCOUT_TRANSCRIBE=0
# SCOUT_IG_COOKIES=/data/cookies.txt
# SCOUT_WHISPER_MODEL=base

# Contact shown on /privacy, /terms and /data-deletion (Meta asks for these if you submit your app for review)
SCOUT_OPERATOR=
SCOUT_CONTACT_EMAIL=
