# Copy to .env and fill in. Never commit .env.

# Required for the server: a random lock for the REST API (24+ chars)
#   python3 -c "import secrets;print(secrets.token_urlsafe(32))"
SCOUT_API_KEY=

# Optional: enables the claude.ai connector at https://<your host>/mcp/<this secret>  (24+ chars, keep it private)
SCOUT_MCP_SECRET=

# YouTube Data API key(s). Extra keys spread the daily quota.
YOUTUBE_API_KEY=
# YOUTUBE_API_KEY_2=

# Instagram (your own Meta app). One account:
SCOUT_IG_TOKEN=
SCOUT_IG_USER_ID=
# ...or several tokens in a JSON file: SCOUT_IG_POOL=/data/.scout/ig_pool.json

# Creator breakdowns: who to compare with, and the handle on the end card
SCOUT_SHOWCASE_ME=
SCOUT_SHOWCASE_CTA=

# Reel transcription is off by default. Turning it on downloads reels with yt-dlp, which Instagram's terms do not allow
# and usually needs a logged-in cookies file. Your call and your responsibility.
SCOUT_TRANSCRIBE=0
# SCOUT_IG_COOKIES=/data/cookies.txt
# SCOUT_WHISPER_MODEL=base

# Contact shown on /privacy, /terms and /data-deletion (Meta asks for these if you submit your app for review)
SCOUT_OPERATOR=
SCOUT_CONTACT_EMAIL=
